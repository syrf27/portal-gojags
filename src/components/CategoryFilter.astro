---
import type { Category } from '../types';
export interface Props {
  categories: Category[];
  active: string;
}

const { categories, active } = Astro.props;
---

<nav class="flex flex-wrap justify-center gap-2" aria-label="Category filter">
  <button
    data-category="all"
    class="px-4 py-1.5 text-sm font-medium rounded-lg border transition-all duration-300 ease-out cursor-pointer hover:shadow-sm"
    class:list={{
      'border-transparent': active === 'all',
      'border-[var(--color-border)]': active !== 'all',
    }}
    style={{
      background: active === 'all' ? 'var(--color-accent)' : 'transparent',
      color: active === 'all' ? 'white' : 'var(--color-text-secondary)',
    }}
    aria-pressed={active === 'all' ? 'true' : 'false'}
  >
    Semua
  </button>
  {categories.map((cat) => (
    <button
      data-category={cat.id}
      class="px-4 py-1.5 text-sm font-medium rounded-lg border transition-all duration-300 ease-out cursor-pointer hover:shadow-sm"
      class:list={{
        'border-transparent': active === cat.id,
        'border-[var(--color-border)]': active !== cat.id,
      }}
      style={{
        background: active === cat.id ? 'var(--color-accent)' : 'transparent',
        color: active === cat.id ? 'white' : 'var(--color-text-secondary)',
      }}
      aria-pressed={active === cat.id ? 'true' : 'false'}
    >
      {cat.name}
    </button>
  ))}
</nav>
