---
import { applications, categories } from '../data/applications';

function fmt(n: number): string {
  if (n >= 1000) {
    const k = (n / 1000).toFixed(1);
    return k.endsWith('.0') ? `${parseInt(k)}k+` : `${k}k+`;
  }
  return String(n);
}

const stats = [
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>`,
    value: '0',
    rawValue: applications.length,
    label: 'Total Aplikasi',
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 10h16M4 14h10"/></svg>`,
    value: '0',
    rawValue: categories.length,
    label: 'Kategori Layanan',
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>`,
    value: '0',
    rawValue: applications.filter((a) => a.isPublished === false).length,
    label: 'Segera Hadir',
  },
];
---

<section class="stats-bar-section">
  <div class="stats-bar-inner">
    {stats.map((stat, i) => (
      <div class="stats-bar-item">
        <div class="stats-bar-icon" set:html={stat.icon} />
        <div class="stats-bar-text">
          <span
            class="stats-bar-value"
            id={stat.id}
            data-count-target={stat.rawValue !== null && stat.rawValue !== undefined ? String(stat.rawValue) : undefined}
          >{stat.value}</span>
          <span class="stats-bar-label">{stat.label}</span>
        </div>
        {i < stats.length - 1 && <div class="stats-bar-divider" />}
      </div>
    ))}
  </div>
</section>

<script>
  (function () {
    // Animated count-up
    function animateCount(el, target, duration) {
      var start = 0;
      var startTime = null;
      function step(ts) {
        if (!startTime) startTime = ts;
        var progress = Math.min((ts - startTime) / duration, 1);
        // ease-out cubic
        var eased = 1 - Math.pow(1 - progress, 3);
        var current = Math.round(eased * target);
        el.textContent = current.toLocaleString('id-ID');
        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          el.textContent = target.toLocaleString('id-ID');
          el.classList.add('count-updated');
          setTimeout(function () { el.classList.remove('count-updated'); }, 500);
        }
      }
      requestAnimationFrame(step);
    }

    // Trigger counts when stats bar is visible
    var section = document.querySelector('.stats-bar-section');
    var triggered = false;

    function runCounts() {
      // Animate static stats from data attributes
      document.querySelectorAll('[data-count-target]').forEach(function (el) {
        var target = parseInt(el.getAttribute('data-count-target'), 10);
        animateCount(el, target, 1400);
      });
    }

    var io = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting && !triggered) {
        triggered = true;
        io.disconnect();
        runCounts();
      }
    }, { threshold: 0.3 });

    if (section) io.observe(section);
  })();
</script>

<style>
  .stats-bar-section {
    width: 100%;
    padding: 0 1.5rem;
    margin: 3rem 0 0;
  }

  .stats-bar-inner {
    max-width: 860px;
    margin: 0 auto;
    background: var(--color-accent);
    border-radius: 16px;
    display: flex;
    align-items: stretch;
    padding: 0;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
  }

  .stats-bar-item {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.6rem 2rem;
    position: relative;
  }

  .stats-bar-icon {
    color: rgba(255,255,255,0.85);
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .stats-bar-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stats-bar-value {
    font-size: 1.6rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stats-bar-label {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.75);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .stats-bar-divider {
    position: absolute;
    right: 0;
    top: 20%;
    height: 60%;
    width: 1px;
    background: rgba(255,255,255,0.25);
  }

  @media (max-width: 600px) {
    .stats-bar-inner {
      flex-direction: column;
    }
    .stats-bar-divider {
      top: auto;
      bottom: 0;
      right: 10%;
      height: 1px;
      width: 80%;
    }
  }
</style>
