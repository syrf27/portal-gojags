---
export interface Props {
  href?: string;
  title?: string;
  label?: string;
}

const {
  href = '#',
  title = 'Panduan Penggunaan Aplikasi GOJAGS',
  label = 'Lihat Panduan',
} = Astro.props;
---

<!-- Full-width amber background, inner content centered like the rest of the page -->
<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="panduan-banner"
  style="display:block; width:100%; background:var(--color-accent); text-decoration:none;"
  aria-label={title}
>
  <div style="max-width:80rem; margin:0 auto; padding:0.75rem 2rem; display:flex; align-items:center; justify-content:space-between; gap:1rem;">

    <span style="font-size:0.875rem; font-weight:700; color:#ffffff; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
      {title}
    </span>

    <span style="display:inline-flex; align-items:center; gap:6px; font-size:0.82rem; font-weight:700; color:#ffffff; white-space:nowrap; flex-shrink:0;" class="panduan-link">
      {label}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="panduan-arrow" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12 5 19 12 12 19"/>
      </svg>
    </span>

  </div>
</a>

<style>
  .panduan-banner:hover {
    filter: brightness(0.9);
  }

  .panduan-arrow {
    transition: transform 0.2s ease;
  }

  .panduan-banner:hover .panduan-arrow {
    transform: translateX(4px);
  }
</style>
