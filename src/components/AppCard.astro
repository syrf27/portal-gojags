---
import type { Application } from '../types';
export interface Props {
  app: Application;
}

const { app } = Astro.props;

const categoryColor: Record<string, string> = {
  eksternal: '#3b82f6',
  internal: '#8b5cf6',
};
const color = categoryColor[app.category] || '#6b7280';
const isPublished = app.isPublished !== false;
---

<article
  class="group relative rounded-xl border flex flex-col transition-all duration-300 ease-out shadow-sm hover:shadow-md hover:border-[var(--color-accent)]"
  style="background: var(--color-card); border-color: var(--color-border-light);"
  tabindex="0"
  role="article"
  aria-label={`${app.name} - ${app.description}`}
>
  <div class="flex items-start gap-3 px-5 pt-5 pb-3">
    <img
      src="/gojags-logo.png"
      alt=""
      width="36"
      height="36"
      class="rounded-lg shrink-0"
      aria-hidden="true"
      loading="lazy"
    />
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2">
        <h3 class="text-[15px] font-semibold" style="color: var(--color-text-primary);">{app.name}</h3>
        {!isPublished && (
          <span class="text-[10px] px-1.5 py-0.5 rounded font-medium whitespace-nowrap" style="background: color-mix(in srgb, var(--color-warning) 15%, transparent); color: var(--color-warning);">Development</span>
        )}
      </div>
      <p class="text-sm mt-1 leading-relaxed" style="color: var(--color-text-secondary);">{app.description}</p>
    </div>
  </div>

  <div class="mt-auto flex items-center justify-between px-5 py-4 border-t" style="border-color: var(--color-border-light);">
    <span
      class="text-xs px-2 py-0.5 rounded-full font-medium"
      style={`background: color-mix(in srgb, ${color} 12%, transparent); color: ${color};`}
    >
      {app.category === 'eksternal' ? 'Eksternal' : 'Internal'}
    </span>
    {isPublished ? (
      <a
        href={app.url}
        class="inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-lg transition-colors"
        style="color: var(--color-accent);"
        aria-label={`Buka ${app.name}`}
      >
        Buka
        <svg class="transition-transform duration-300 group-hover:animate-slide-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    ) : (
      <span class="inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-lg" style="color: var(--color-text-tertiary);">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        Segera Hadir
      </span>
    )}
  </div>

  {isPublished && (
    <a
      href={app.url}
      class="absolute inset-0 rounded-xl focus:outline-none"
      aria-label={`Open ${app.name}`}
      tabindex="-1"
    ></a>
  )}
</article>

<style>
  article:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

</style>
