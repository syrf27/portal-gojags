---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import AppGrid from '../components/AppGrid.astro';
import StatsBar from '../components/StatsBar.astro';
import MobileAppSection from '../components/MobileAppSection.astro';
import { applications, categories } from '../data/applications';

const allCategories = [{ id: 'favorites', name: 'Favorit' }, ...categories];
---

<Layout>
  <Hero />
  <div id="apps-section" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6 overflow-x-auto pb-2">
      <CategoryFilter categories={allCategories} active="all" />
    </div>

    <div id="portal-content">
      <AppGrid title="Semua Aplikasi" applications={applications} id="all-apps-section" />
    </div>
  </div>

  <StatsBar />
  <MobileAppSection />
</Layout>

<script is:inline define:vars={{ applicationsData: applications }}>
var currentCategory = 'all';
var currentQuery = '';

function renderApps(apps) {
  var title;
  if (currentQuery) {
    title = 'Aplikasi "' + currentQuery + '"';
  } else if (currentCategory === 'favorites') {
    title = 'Aplikasi Favorit';
  } else if (currentCategory === 'all') {
    title = 'Semua Aplikasi';
  } else {
    var catName = currentCategory.charAt(0).toUpperCase() + currentCategory.slice(1);
    title = 'Aplikasi ' + catName;
  }
  
  var html = '<section class="mb-12"><h2 class="text-lg font-semibold mb-5" style="color:var(--color-text-primary)">' + title + '</h2><div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">' +
    apps.map(function(a) { return renderCard(a); }).join('') +
    '</div></section>';

  if (apps.length === 0) {
    document.getElementById('portal-content').innerHTML = '<div class="text-center py-16"><p class="text-sm" style="color:var(--color-text-tertiary)">Tidak ada aplikasi yang ditemukan.</p></div>';
  } else {
    document.getElementById('portal-content').innerHTML = html;
  }
}

function filterApps() {
  var filtered = applicationsData.slice();
  
  if (currentCategory === 'favorites') {
    filtered = filtered.filter(function(a) { return a.isFavorite === true; });
  } else if (currentCategory !== 'all') {
    filtered = filtered.filter(function(a) { return a.category === currentCategory; });
  }

  if (currentQuery) {
    var q = currentQuery.toLowerCase().trim();
    if (q) {
      filtered = filtered.filter(function(a) {
        return a.name.toLowerCase().indexOf(q) !== -1 ||
               a.description.toLowerCase().indexOf(q) !== -1 ||
               a.category.indexOf(q) !== -1;
      });
    }
  }
  
  renderApps(filtered);
}

var categoryColors = { eksternal: '#3b82f6', internal: '#8b5cf6' };

function renderCard(a) {
  var color = categoryColors[a.category] || '#6b7280';
  var catName = a.category === 'eksternal' ? 'Eksternal' : 'Internal';
  var published = a.isPublished !== false;
  var html = '<article class="group relative rounded-xl border flex flex-col transition-all duration-300 ease-out shadow-sm hover:shadow-md hover:border-[var(--color-accent)]" style="background:var(--color-card);border-color:var(--color-border-light)" tabindex="0" role="article" aria-label="' + a.name + ' - ' + a.description + '">' +
    '<div class="flex items-start gap-3 px-5 pt-5 pb-3">' +
      '<img src="/gojags-logo.png" alt="" width="36" height="36" class="rounded-lg shrink-0" aria-hidden="true" loading="lazy">' +
      '<div class="min-w-0 flex-1">' +
        '<div class="flex items-center gap-2">' +
          '<h3 class="text-[15px] font-semibold" style="color:var(--color-text-primary)">' + a.name + '</h3>' +
          (published ? '' : '<span class="text-[10px] px-1.5 py-0.5 rounded font-medium whitespace-nowrap" style="background:color-mix(in srgb, var(--color-warning) 15%, transparent);color:var(--color-warning)">Development</span>') +
        '</div>' +
        '<p class="text-sm mt-1 leading-relaxed" style="color:var(--color-text-secondary)">' + a.description + '</p>' +
      '</div>' +
    '</div>' +
    '<div class="mt-auto flex items-center justify-between px-5 py-4 border-t" style="border-color:var(--color-border-light)">' +
      '<span class="text-xs px-2 py-0.5 rounded-full font-medium" style="background:color-mix(in srgb, ' + color + ' 12%, transparent);color:' + color + '">' + catName + '</span>' +
      (published
        ? '<a href="' + a.url + '" class="inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-lg transition-colors" style="color:var(--color-accent)" aria-label="Buka ' + a.name + '">Buka<svg class="transition-transform duration-300 group-hover:animate-slide-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>'
        : '<span class="inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-lg" style="color:var(--color-text-tertiary)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>Segera Hadir</span>'
      ) +
    '</div>' +
    (published ? '<a href="' + a.url + '" class="absolute inset-0 rounded-xl focus:outline-none" aria-label="Buka ' + a.name + '" tabindex="-1"></a>' : '') +
  '</article>';
  return html;
}

function updateActiveCategory(cat) {
  document.querySelectorAll('[data-category]').forEach(function(btn) {
    var c = btn.getAttribute('data-category');
    var isActive = c === cat;
    btn.style.background = isActive ? 'var(--color-accent)' : 'transparent';
    btn.style.color = isActive ? 'white' : 'var(--color-text-secondary)';
    btn.style.borderColor = isActive ? 'transparent' : 'var(--color-border)';
    btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
  });
}

var heroSearch = document.getElementById('hero-search');
if (heroSearch) {
  heroSearch.addEventListener('input', function() {
    currentQuery = heroSearch.value || '';
    filterApps();
  });
}

var searchForm = document.getElementById('search-form');
if (searchForm) {
  searchForm.addEventListener('submit', function(e) {
    e.preventDefault();
    document.getElementById('apps-section').scrollIntoView({ behavior: 'smooth' });
  });
}

document.addEventListener('click', function(e) {
  var btn = e.target.closest('[data-category]');
  if (btn) {
    currentCategory = btn.getAttribute('data-category') || 'all';
    updateActiveCategory(currentCategory);
    filterApps();
  }
});
</script>
